# ==============================================================================
# DocIScan: AI Fake Identity & Document Screening System
# Backend Environment Configuration Template (.env.example)
# NOTE: All values must remain empty placeholders in this template.
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS TO THIS FILE.
# ==============================================================================

# Database & Supabase Configuration
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=

# Google Cloud Document AI Configuration (Optional / Enterprise OCR)
GOOGLE_CLOUD_PROJECT_ID=
DOCUMENT_AI_LOCATION=
DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Authoritative Government Verification Providers (Optional / Licensed)
# PAN Verification (NSDL / Income Tax Department)
PAN_VERIFICATION_ENABLED=false
PAN_API_KEY=
PAN_CLIENT_ID=
PAN_API_ENDPOINT=

# Aadhaar Verification (UIDAI AUA Gateway)
AADHAAR_VERIFICATION_ENABLED=false
AADHAAR_AUA_CODE=
AADHAAR_AUTH_KEY=
AADHAAR_API_ENDPOINT=

# Passport & Travel Document Verification (ICAO PKD / Consular Gateway)
PASSPORT_VERIFICATION_ENABLED=false
PASSPORT_VERIFICATION_API_KEY=
PASSPORT_API_ENDPOINT=

# Visa Verification (Immigration Authority Gateway)
VISA_VERIFICATION_ENABLED=false
VISA_VERIFICATION_API_KEY=
VISA_API_ENDPOINT=

# Forensic & Tamper Verification SDK (Regula / Approved Provider)
DOCUMENT_VERIFICATION_PROVIDER=
DOCUMENT_VERIFICATION_LICENSE=
DOCUMENT_VERIFICATION_API_KEY=

# Telecom SMS Gateway (Fast2SMS for Indian Officer OTP Delivery)
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
